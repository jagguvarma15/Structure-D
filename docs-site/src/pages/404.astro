---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — Page Not Found">
  <Navbar />

  <main class="not-found">
    <div class="container not-found-inner">
      <div class="not-found-terminal reveal">
        <div class="terminal-titlebar">
          <div class="terminal-dots">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
          </div>
          <span class="terminal-title">bash</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">structure-d extract this_page.html --schema key_value</span>
          </div>
          <span class="terminal-output">⚠ ParserError: file not found — this_page.html</span>
          <span class="terminal-output">  File path: /docs/this_page</span>
          <span class="terminal-output">  HTTP status: <span style="color: var(--error)">404</span></span>
        </div>
      </div>

      <div class="not-found-content reveal" style="transition-delay: 100ms">
        <p class="not-found-code">404</p>
        <h1 class="not-found-title">Page not found</h1>
        <p class="not-found-desc">
          The page you're looking for doesn't exist or has been moved.
          Check the URL or navigate back to safety.
        </p>
        <div class="not-found-actions">
          <a href={base} class="btn btn-primary">← Back to Home</a>
          <a href={`${base}docs/getting-started`} class="btn btn-secondary">Docs</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--nav-height);
  }

  .not-found-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
    max-width: 900px;
  }

  .not-found-terminal {
    max-width: 420px;
  }

  .not-found-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .not-found-code {
    font-family: var(--font-mono);
    font-size: 5rem;
    font-weight: 600;
    line-height: 1;
    background: linear-gradient(135deg, var(--accent) 0%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .not-found-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .not-found-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 380px;
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .not-found-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-5);
    }
    .not-found-terminal { max-width: 100%; }
    .not-found-desc { max-width: 100%; }
    .not-found-actions { justify-content: center; }
  }
</style>
