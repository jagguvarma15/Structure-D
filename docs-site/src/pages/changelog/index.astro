---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import SearchModal from '../../components/SearchModal.astro';
import '../../styles/global.css';

const base = import.meta.env.BASE_URL;

const releases = [
  {
    version: 'v0.2.0',
    date: 'March 2026',
    status: 'latest',
    summary: 'Adds the full RAG indexing layer, a high-performance Rust CLI, cloud destination writers, provider fallback chaining, and observability with Prometheus + OpenTelemetry.',
    highlights: [
      { icon: 'RAG', label: 'Retrieval-Augmented Generation', desc: 'New DocumentReader, VectorStoreIndex, SummaryIndex, QueryEngine, and RAGPipeline — compatible with the LlamaIndex API.' },
      { icon: 'CLI', label: 'Rust CLI', desc: 'Native binary with extract, batch, formats, models, schemas, config, and providers subcommands. Zero Python overhead for batch jobs.' },
      { icon: 'FBK', label: 'FallbackProvider', desc: 'Chain two providers transparently — primary runs first, fallback takes over on InferenceError. Configurable via YAML or code.' },
    ],
    changes: [
      { type: 'added',    text: 'RAG indexing layer: DocumentReader, VectorStoreIndex, SummaryIndex, QueryEngine, RAGPipeline' },
      { type: 'added',    text: 'LlamaIndex-compatible API — load_and_chunk(), as_query_engine(), insert_nodes()' },
      { type: 'added',    text: 'Rust CLI with extract, batch, formats, models, schemas, config, providers subcommands' },
      { type: 'added',    text: 'FallbackProvider for transparent two-provider chaining on InferenceError' },
      { type: 'added',    text: 'Cloud destination writers: Snowflake, BigQuery, MySQL, Redshift' },
      { type: 'added',    text: 'Monitoring: Prometheus metrics endpoint + OpenTelemetry tracing exporter' },
      { type: 'improved', text: 'Chunker — new semantic strategy: heading-aware sentence splitting' },
      { type: 'improved', text: 'SchemaValidator — multi-step extraction: JSON &rarr; code fence &rarr; block heuristics fallback' },
      { type: 'improved', text: 'ModelRegistry — added deepseek-r1-70b and qwen-vl-7b (multimodal) entries' },
      { type: 'improved', text: 'Pipeline.run_many() — now returns dict keyed by filename for easier iteration' },
      { type: 'fixed',    text: 'OCR parser encoding issue on non-ASCII (CJK, Arabic) documents' },
      { type: 'fixed',    text: 'EmailParser failing on malformed MIME boundaries' },
      { type: 'fixed',    text: 'VLLMProvider not sending system_prompt correctly on chat-template models' },
      { type: 'fixed',    text: 'CSVWriter writing None as string "None" instead of empty field' },
    ],
  },
  {
    version: 'v0.1.0',
    date: 'January 2026',
    status: 'stable',
    summary: 'Initial release. The full six-stage pipeline, 14 format parsers, five LLM providers, eight built-in schemas, model routing, source connectors, and a FastAPI service.',
    highlights: [
      { icon: 'PIP', label: 'Core pipeline', desc: 'Ingestion → Preprocessing → Routing → Inference → Validation → Storage. Fully async throughout.' },
      { icon: 'FMT', label: '14 format parsers', desc: 'PyMuPDF, PDFPlumber, OCR-PDF, Tesseract image, HTML, DOCX, XLSX, PPTX, email, transcript, plain text.' },
      { icon: 'SCH', label: 'Schema-driven', desc: 'Eight built-in Pydantic schemas and a get_schema() registry. Bring any BaseModel as your extraction target.' },
    ],
    changes: [
      { type: 'added', text: 'Core six-stage pipeline: Ingestion &rarr; Preprocessing &rarr; Routing &rarr; Inference &rarr; Validation &rarr; Storage' },
      { type: 'added', text: 'Format parsers: pymupdf, pdfplumber, ocr_pdf, tesseract_image, html, docx, xlsx, pptx, email, transcript, plaintext' },
      { type: 'added', text: 'LLM providers: VLLMProvider (guided_json), OpenAIProvider, AnthropicProvider (tool-use), GeminiProvider, OllamaProvider' },
      { type: 'added', text: 'Built-in schemas: key_value, table, entity, classification, summary, form, document_structure, generic' },
      { type: 'added', text: 'ModelRegistry with 7 pre-registered models and task-based ModelRouter' },
      { type: 'added', text: 'Source connectors: LocalConnector, S3Connector, GCSConnector, AzureConnector, SFTPConnector' },
      { type: 'added', text: 'FastAPI service with /extract, /health, /models, /schemas, /formats endpoints' },
      { type: 'added', text: 'Storage writers: JSONLWriter, CSVWriter' },
      { type: 'added', text: 'BatchProcessor with configurable concurrency via asyncio.Semaphore' },
      { type: 'added', text: 'SchemaValidator + RetryHandler — up to max_retries corrective retry attempts' },
      { type: 'added', text: 'Chunker with fixed, sentence, heading, and semantic strategies' },
      { type: 'added', text: 'Settings and YAML config loader with SD_* environment variable overrides' },
      { type: 'added', text: '110 unit tests across pipeline, parsers, validators, storage, API, and schemas' },
    ],
  },
];

const typeConfig: Record<string, { label: string; color: string; bg: string }> = {
  added:    { label: 'Added',    color: 'var(--success)',  bg: 'rgba(22, 163, 74, 0.08)' },
  improved: { label: 'Improved', color: 'var(--accent)',   bg: 'rgba(37, 99, 235, 0.08)' },
  fixed:    { label: 'Fixed',    color: 'var(--warning)',  bg: 'rgba(217, 119, 6, 0.08)' },
  breaking: { label: 'Breaking', color: 'var(--error)',    bg: 'rgba(220, 38, 38, 0.08)' },
};

const roadmap = [
  {
    version: 'v0.3.0',
    eta: 'Q2 2026',
    title: 'ETL Pipeline Framework',
    items: [
      'Scheduled batch processing with cron-style triggers',
      'YAML workflow definitions (sources, transforms, destinations)',
      'Per-field success rates, fill rates, and cost tracking',
      'Resume failed batches from checkpoint',
      'Native Airflow / Prefect operator',
    ],
  },
  {
    version: 'v0.4.0',
    eta: 'Q3 2026',
    title: 'Human-in-the-Loop',
    items: [
      'HITL review queue for low-confidence extractions',
      'API authentication (API key + JWT) + rate limiting',
      'React-based monitoring dashboard',
      'Versioned prompt template management',
      'Feedback loop — approved corrections update model routing heuristics',
    ],
  },
  {
    version: 'v0.5.0',
    eta: 'Q4 2026',
    title: 'Multi-Modal & Agents',
    items: [
      'Native vision models (GPT-4o, Claude Sonnet vision, Qwen-VL)',
      'Table-from-image extraction without OCR',
      'Agent-mode extraction — model requests specific page regions',
      'Streaming output support',
    ],
  },
];
---

<BaseLayout title="Changelog" description="Version history and release notes for Structure-D.">
  <Navbar activePath="/changelog" />

  <main class="changelog-main">
    <div class="container">
      <header class="changelog-header reveal">
        <p class="label-mono">Changelog</p>
        <h1 class="changelog-title">Release history</h1>
        <p class="changelog-desc">
          All notable changes to Structure-D are documented here.<br />
          Follows <a href="https://keepachangelog.com" target="_blank" rel="noopener">Keep a Changelog</a> format.
        </p>
        <div class="changelog-links">
          <a href="https://github.com/jagguvarma15/Structure-D/releases" target="_blank" rel="noopener" class="btn btn-secondary">
            GitHub Releases &rarr;
          </a>
          <a href="https://github.com/jagguvarma15/Structure-D/blob/main/CHANGELOG.md" target="_blank" rel="noopener" class="btn btn-ghost">
            View raw CHANGELOG.md
          </a>
        </div>
      </header>

      <div class="releases">
        {releases.map((release, ri) => (
          <article class="release reveal" style={`transition-delay: ${ri * 100}ms`}>
            <div class="release-timeline">
              <div class:list={['timeline-dot', { latest: release.status === 'latest' }]}></div>
              {ri < releases.length - 1 && <div class="timeline-line"></div>}
            </div>

            <div class="release-content">
              <div class="release-header">
                <div class="release-meta">
                  <h2 class="release-version">{release.version}</h2>
                  <time class="release-date">{release.date}</time>
                  {release.status === 'latest' && (
                    <span class="release-badge-latest">Latest</span>
                  )}
                  {release.status === 'stable' && (
                    <span class="release-badge-stable">Stable</span>
                  )}
                </div>
                <a
                  href={`https://github.com/jagguvarma15/Structure-D/releases/tag/${release.version}`}
                  target="_blank"
                  rel="noopener"
                  class="release-github-link"
                >
                  View on GitHub &nearr;
                </a>
              </div>

              <p class="release-summary">{release.summary}</p>

              <div class="release-highlights">
                {release.highlights.map(h => (
                  <div class="highlight-card">
                    <span class="highlight-icon">{h.icon}</span>
                    <div>
                      <p class="highlight-label">{h.label}</p>
                      <p class="highlight-desc">{h.desc}</p>
                    </div>
                  </div>
                ))}
              </div>

              <h3 class="changes-heading">All changes</h3>
              <ul class="release-changes">
                {release.changes.map((change) => {
                  const cfg = typeConfig[change.type] || typeConfig.added;
                  return (
                    <li class="change-item">
                      <span
                        class="change-badge"
                        style={`color: ${cfg.color}; background: ${cfg.bg}; border: 1px solid ${cfg.color}30`}
                      >
                        {cfg.label}
                      </span>
                      <span class="change-text" set:html={change.text}></span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <!-- Roadmap -->
      <section class="roadmap reveal">
        <div class="roadmap-header">
          <p class="label-mono">Upcoming</p>
          <h2 class="roadmap-title">What's next</h2>
          <p class="roadmap-desc">
            The roadmap is open — contributions and feedback welcome on
            <a href="https://github.com/jagguvarma15/Structure-D/discussions" target="_blank" rel="noopener">GitHub Discussions</a>.
          </p>
        </div>

        <div class="roadmap-grid">
          {roadmap.map((r) => (
            <div class="roadmap-card">
              <div class="roadmap-meta">
                <span class="roadmap-version">{r.version}</span>
                <span class="roadmap-eta">{r.eta}</span>
              </div>
              <h3 class="roadmap-item-title">{r.title}</h3>
              <ul class="roadmap-items">
                {r.items.map(item => (
                  <li class="roadmap-item">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="3"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Subscribe to releases -->
      <div class="watch-section reveal">
        <div class="watch-inner">
          <div>
            <p class="watch-title">Stay updated</p>
            <p class="watch-desc">Watch the GitHub repository to get notified of new releases.</p>
          </div>
          <a href="https://github.com/jagguvarma15/Structure-D/releases" target="_blank" rel="noopener" class="btn btn-primary">
            Watch on GitHub &rarr;
          </a>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <SearchModal />
</BaseLayout>

<style>
  .changelog-main {
    padding-top: calc(var(--nav-height) + var(--space-8));
    padding-bottom: var(--space-8);
    min-height: 100vh;
  }

  .changelog-header {
    max-width: 640px;
    margin-bottom: var(--space-7);
  }

  .changelog-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-top: 12px;
  }

  .changelog-desc {
    margin-top: 12px;
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .changelog-links {
    display: flex;
    gap: 10px;
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  /* Timeline */
  .releases {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 820px;
  }

  .release {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 0 var(--space-4);
  }

  .release-timeline {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 8px;
  }

  .timeline-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid var(--border-default);
    background: var(--bg-root);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
    transition: border-color var(--duration-fast);
  }

  .timeline-dot.latest {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-glow);
  }

  .timeline-line {
    flex: 1;
    width: 1px;
    background: linear-gradient(to bottom, var(--border-default), var(--border-subtle));
    min-height: 40px;
    margin: 8px 0;
  }

  .release-content {
    padding-bottom: var(--space-7);
  }

  .release-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
    flex-wrap: wrap;
  }

  .release-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .release-version {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .release-date {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-dim);
  }

  .release-badge-latest,
  .release-badge-stable {
    font-family: var(--font-mono);
    font-size: 10px;
    border-radius: 9999px;
    padding: 3px 8px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .release-badge-latest {
    background: rgba(22, 163, 74, 0.1);
    color: var(--success);
    border: 1px solid rgba(22, 163, 74, 0.25);
  }

  .release-badge-stable {
    background: var(--bg-secondary);
    color: var(--text-dim);
    border: 1px solid var(--border-default);
  }

  .release-github-link {
    font-size: var(--text-xs);
    color: var(--text-dim);
    text-decoration: none;
    transition: color var(--duration-fast);
    white-space: nowrap;
    margin-top: 6px;
  }

  .release-github-link:hover { color: var(--accent); }

  .release-summary {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  /* Highlights */
  .release-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: var(--space-5);
  }

  .highlight-card {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--border-default);
    border-radius: 8px;
    background: var(--bg-secondary);
  }

  .highlight-icon {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-subtle);
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 4px;
    padding: 3px 6px;
    flex-shrink: 0;
    letter-spacing: 0.04em;
    margin-top: 1px;
  }

  .highlight-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }

  .highlight-desc {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .changes-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 12px;
    margin-top: var(--space-2);
  }

  .release-changes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .change-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .change-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 1px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .change-text {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Roadmap */
  .roadmap {
    margin-top: var(--space-8);
    max-width: 820px;
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-7);
  }

  .roadmap-header {
    margin-bottom: var(--space-5);
  }

  .roadmap-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 10px 0 8px;
  }

  .roadmap-desc {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .roadmap-card {
    padding: var(--space-4);
    border: 1px solid var(--border-default);
    border-radius: 10px;
    background: var(--bg-secondary);
    transition: border-color var(--duration-fast);
  }

  .roadmap-card:hover { border-color: var(--border-bright); }

  .roadmap-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .roadmap-version {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-subtle);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .roadmap-eta {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-dim);
  }

  .roadmap-item-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .roadmap-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .roadmap-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .roadmap-item svg {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--text-dim);
  }

  /* Watch section */
  .watch-section {
    margin-top: var(--space-7);
    max-width: 820px;
  }

  .watch-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    background: var(--bg-secondary);
    flex-wrap: wrap;
  }

  .watch-title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .watch-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .release-highlights { grid-template-columns: 1fr; }
    .roadmap-grid { grid-template-columns: 1fr; }
    .release-header { flex-direction: column; }
  }

  @media (max-width: 640px) {
    .watch-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
