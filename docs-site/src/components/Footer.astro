---
const base = import.meta.env.BASE_URL;
---

<footer class="footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <span class="footer-logo">structure-d</span>
      <span class="footer-desc">Convert unstructured documents into validated structured data.</span>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <span class="footer-col-title">Documentation</span>
        <a href={`${base}docs/getting-started`}>Getting Started</a>
        <a href={`${base}docs/installation`}>Installation</a>
        <a href={`${base}docs/configuration`}>Configuration</a>
        <a href={`${base}docs/guides/basic-usage`}>Basic Usage</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">API Reference</span>
        <a href={`${base}docs/api/overview`}>Overview</a>
        <a href={`${base}docs/api/core`}>Core Pipeline</a>
        <a href={`${base}docs/api/models`}>Models & Providers</a>
        <a href={`${base}docs/api/utilities`}>Utilities</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-title">Project</span>
        <a href={`${base}changelog`}>Changelog</a>
        <a href="https://github.com/JagadeshVarma/Structure-D" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://github.com/JagadeshVarma/Structure-D/issues" target="_blank" rel="noopener">Issues ↗</a>
        <a href="https://github.com/JagadeshVarma/Structure-D/blob/main/LICENSE" target="_blank" rel="noopener">MIT License ↗</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom container">
    <span>Built by <a href="https://github.com/JagadeshVarma" target="_blank" rel="noopener">@JagadeshVarma</a> · MIT License · Python 3.10+</span>
    <span class="footer-version">v0.2.0</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--space-8);
    padding: var(--space-7) 0 var(--space-4);
    background: var(--bg-primary);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-7);
    margin-bottom: var(--space-6);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .footer-desc {
    font-size: var(--text-sm);
    color: var(--text-dim);
    max-width: 280px;
  }

  .footer-links {
    display: flex;
    gap: var(--space-7);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 140px;
  }

  .footer-col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 4px;
  }

  .footer-col a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-col a:hover { color: var(--text-primary); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--text-dim);
  }

  .footer-bottom a {
    color: var(--text-secondary);
    transition: color var(--duration-fast);
  }

  .footer-bottom a:hover { color: var(--accent); }

  .footer-version {
    font-family: var(--font-mono);
  }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
    .footer-links {
      flex-wrap: wrap;
      gap: var(--space-5);
    }
  }

  @media (max-width: 640px) {
    .footer-links { gap: var(--space-4); }
    .footer-col { min-width: 120px; }
  }
</style>
