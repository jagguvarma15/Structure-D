---
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={base} class="footer-logo">structure-d</a>
      <p class="footer-tagline">
        Modular LLM pipeline for extracting structured data<br />from any document format.
      </p>
      <div class="footer-badges">
        <img src="https://img.shields.io/badge/python-3.10%2B-blue?style=flat-square&logo=python&logoColor=white" alt="Python 3.10+" loading="lazy" />
        <img src="https://img.shields.io/badge/license-MIT-green?style=flat-square" alt="MIT License" loading="lazy" />
      </div>
    </div>

    <div class="footer-links-group">
      <h4 class="footer-group-title">Docs</h4>
      <ul class="footer-links" role="list">
        <li><a href={`${base}docs/getting-started`}>Getting Started</a></li>
        <li><a href={`${base}docs/installation`}>Installation</a></li>
        <li><a href={`${base}docs/configuration`}>Configuration</a></li>
        <li><a href={`${base}docs/guides/basic-usage`}>Basic Usage</a></li>
        <li><a href={`${base}docs/guides/advanced`}>Advanced</a></li>
        <li><a href={`${base}docs/guides/deployment`}>Deployment</a></li>
      </ul>
    </div>

    <div class="footer-links-group">
      <h4 class="footer-group-title">AI</h4>
      <ul class="footer-links" role="list">
        <li><a href={`${base}docs/api/overview`}>Overview</a></li>
        <li><a href={`${base}docs/api/core`}>Core Pipeline</a></li>
        <li><a href={`${base}docs/api/models`}>Models</a></li>
        <li><a href={`${base}docs/api/utilities`}>Utilities</a></li>
        <li><a href={`${base}changelog`}>Changelog</a></li>
      </ul>
    </div>

    <div class="footer-links-group">
      <h4 class="footer-group-title">Project</h4>
      <ul class="footer-links" role="list">
        <li><a href="https://github.com/jagguvarma15/Structure-D" target="_blank" rel="noopener">GitHub ↗</a></li>
        <li><a href="https://github.com/jagguvarma15/Structure-D/issues" target="_blank" rel="noopener">Issues ↗</a></li>
        <li><a href="https://github.com/jagguvarma15/Structure-D/discussions" target="_blank" rel="noopener">Discussions ↗</a></li>
        <li><a href="https://github.com/jagguvarma15/Structure-D/blob/main/LICENSE" target="_blank" rel="noopener">License (MIT) ↗</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <p class="footer-copy">
      &copy; {new Date().getFullYear()} Structure-D. Built with
      <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>.
      Released under the
      <a href="https://github.com/jagguvarma15/Structure-D/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a>.
    </p>
    <p class="footer-made">
      <span class="status-dot"></span>
      Open source · MIT License
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-default);
    padding-top: var(--space-7);
    background: var(--bg-secondary);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr;
    gap: var(--space-6);
    padding-bottom: var(--space-6);
  }

  .footer-logo {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-logo:hover { color: var(--accent); }

  .footer-tagline {
    margin-top: 10px;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .footer-badges {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .footer-group-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 14px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-links a:hover { color: var(--accent); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-top: 1px solid var(--border-default);
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--text-dim);
  }

  .footer-copy a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer-copy a:hover { color: var(--accent); }

  .footer-made {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--text-sm);
    color: var(--text-dim);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    animation: footer-pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes footer-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.4; }
  }

  @media (max-width: 1024px) {
    .footer-inner { grid-template-columns: 1fr 1fr; gap: var(--space-5); }
  }

  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; gap: var(--space-4); }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
