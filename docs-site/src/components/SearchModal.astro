---
const base = import.meta.env.BASE_URL;

const searchData = [
  { title: 'Getting Started', href: `${base}docs/getting-started`, section: 'Docs', excerpt: 'Quick start guide to Structure-D' },
  { title: 'Installation', href: `${base}docs/installation`, section: 'Docs', excerpt: 'Install Structure-D with pip or cargo' },
  { title: 'Configuration', href: `${base}docs/configuration`, section: 'Docs', excerpt: 'Configure providers, models, and storage' },
  { title: 'Basic Usage', href: `${base}docs/guides/basic-usage`, section: 'Guides', excerpt: 'Extract structured data from PDFs and images' },
  { title: 'Advanced Usage', href: `${base}docs/guides/advanced`, section: 'Guides', excerpt: 'Batch processing, RAG indexing, custom schemas' },
  { title: 'Deployment', href: `${base}docs/guides/deployment`, section: 'Guides', excerpt: 'Deploy as FastAPI service or Rust CLI' },
  { title: 'API Overview', href: `${base}docs/api/overview`, section: 'API', excerpt: 'API reference index for all modules' },
  { title: 'Core Pipeline', href: `${base}docs/api/core`, section: 'API', excerpt: 'Pipeline, ExtractionResult, ParsedDocument' },
  { title: 'Models & Providers', href: `${base}docs/api/models`, section: 'API', excerpt: 'OpenAI, Anthropic, vLLM, Ollama providers' },
  { title: 'Utilities', href: `${base}docs/api/utilities`, section: 'API', excerpt: 'Chunker, SchemaValidator, StorageWriters' },
  { title: 'Changelog', href: `${base}changelog`, section: 'Project', excerpt: 'Version history and release notes' },
];
---

<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Search documentation">
  <div class="search-backdrop" id="search-backdrop"></div>
  <div class="search-container">
    <div class="search-header">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
      </svg>
      <input
        type="search"
        id="search-input"
        class="search-input"
        placeholder="Search docs..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-esc">Esc</kbd>
    </div>
    <div class="search-results" id="search-results" role="listbox">
      <p class="search-empty" id="search-empty">Start typing to search...</p>
    </div>
    <div class="search-footer">
      <span><kbd>↑↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>

<script define:vars={{ searchData }}>
  const modal = document.getElementById('search-modal');
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const empty = document.getElementById('search-empty');
  let selectedIndex = -1;

  function close() {
    modal?.classList.remove('open');
    if (input) input.value = '';
    renderResults('');
  }

  function open() {
    modal?.classList.add('open');
    setTimeout(() => input?.focus(), 50);
  }

  backdrop?.addEventListener('click', close);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      modal?.classList.contains('open') ? close() : open();
    }
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      close();
    }
    if (modal?.classList.contains('open')) {
      const items = results?.querySelectorAll('.search-result-item');
      if (!items?.length) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        updateSelected(items);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelected(items);
      } else if (e.key === 'Enter' && selectedIndex >= 0) {
        (items[selectedIndex] as HTMLElement).click();
      }
    }
  });

  function updateSelected(items) {
    items.forEach((item, i) => {
      item.classList.toggle('selected', i === selectedIndex);
    });
  }

  function renderResults(query) {
    if (!query.trim()) {
      results.innerHTML = '';
      empty.style.display = 'block';
      empty.textContent = 'Start typing to search...';
      return;
    }

    const q = query.toLowerCase();
    const matches = searchData.filter(
      (item) =>
        item.title.toLowerCase().includes(q) ||
        item.excerpt.toLowerCase().includes(q) ||
        item.section.toLowerCase().includes(q)
    );

    empty.style.display = matches.length === 0 ? 'block' : 'none';
    if (matches.length === 0) {
      empty.textContent = `No results for "${query}"`;
      results.innerHTML = '';
      return;
    }

    selectedIndex = -1;
    const grouped = {};
    matches.forEach((m) => {
      if (!grouped[m.section]) grouped[m.section] = [];
      grouped[m.section].push(m);
    });

    results.innerHTML = Object.entries(grouped).map(([section, items]) => `
      <div class="search-group">
        <p class="search-group-title">${section}</p>
        ${items.map((item) => `
          <a href="${item.href}" class="search-result-item" role="option">
            <span class="result-title">${highlight(item.title, q)}</span>
            <span class="result-excerpt">${highlight(item.excerpt, q)}</span>
          </a>
        `).join('')}
      </div>
    `).join('');

    results.querySelectorAll('.search-result-item').forEach((item) => {
      item.addEventListener('click', close);
    });
  }

  function highlight(text, query) {
    if (!query) return text;
    const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
  }

  input?.addEventListener('input', (e) => {
    renderResults((e.target).value);
  });
</script>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(60px, 12vh, 120px);
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-in-out);
  }

  .search-modal.open {
    pointer-events: auto;
    opacity: 1;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 17, 23, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .search-container {
    position: relative;
    width: min(640px, calc(100vw - 40px));
    background: var(--bg-root);
    border: 1px solid var(--border-bright);
    border-radius: 12px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.14);
    overflow: hidden;
    transform: scale(0.96) translateY(-8px);
    transition: transform var(--duration-normal) var(--ease-out-expo);
  }

  .search-modal.open .search-container {
    transform: scale(1) translateY(0);
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-default);
  }

  .search-icon { color: var(--text-dim); flex-shrink: 0; }

  .search-input {
    flex: 1;
    background: none;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    color: var(--text-primary);
    caret-color: var(--accent);
  }

  .search-input::placeholder { color: var(--text-dim); }

  .search-esc {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: 4px;
    padding: 2px 6px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .search-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }

  .search-empty {
    text-align: center;
    color: var(--text-dim);
    font-size: var(--text-sm);
    padding: 24px;
  }

  .search-group {
    margin-bottom: 8px;
  }

  .search-group-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    padding: 8px 12px 4px;
  }

  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    border-radius: 6px;
    text-decoration: none;
    cursor: pointer;
    transition: background var(--duration-fast);
  }

  .search-result-item:hover,
  .search-result-item.selected {
    background: var(--bg-elevated);
  }

  .result-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-primary);
  }

  .result-excerpt {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .search-result-item mark {
    background: var(--accent-glow);
    color: var(--accent);
    border-radius: 2px;
    padding: 0 2px;
  }

  .search-footer {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-primary);
  }

  .search-footer span {
    font-size: 11px;
    color: var(--text-dim);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .search-footer kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: 3px;
    padding: 1px 4px;
    color: var(--text-secondary);
  }
</style>
